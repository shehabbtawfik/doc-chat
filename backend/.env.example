# ── LLM Provider ─────────────────────────────────────────────────────────────
#
# DocuMind works with any OpenAI-compatible LLM backend.
# By default it uses Ollama — no API key required.
#
# Option A: Ollama (local, free, private — recommended)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:14b
#
# Pull models first:  ollama pull nomic-embed-text && ollama pull qwen2.5:14b
#
# Option B: OpenAI (cloud, requires API key)
# Uncomment and fill in — leave OLLAMA_BASE_URL set as fallback
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# CHAT_MODEL=gpt-4o-mini
#
# Option C: Any OpenAI-compatible API (LM Studio, Together, Groq, etc.)
# OLLAMA_BASE_URL=http://localhost:1234  # LM Studio default
# CHAT_MODEL=your-model-name
