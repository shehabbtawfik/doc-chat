# ── Option A: OpenAI ──────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ── Option B: Ollama (local / self-hosted) ────────────────────
# Point at your Ollama instance — no API key needed
OLLAMA_BASE_URL=http://localhost:11434

# ── Models ────────────────────────────────────────────────────
# For Ollama: nomic-embed-text + any chat model you have pulled
# For OpenAI: text-embedding-3-small + gpt-4o-mini
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:14b
